# Barındırılan Supabase projesi (telefon bilgisayardan bağımsız çalışsın diye).
# Değerler: Supabase panosu → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# İsteğe bağlı — tekrar hatırlatmalarının sunucudan push olarak gelmesi için (README → Tekrar döngüsü).
# EAS_PROJECT_ID=<npx eas-cli@latest init çıktısındaki proje kimliği>
# GOOGLE_SERVICES_JSON=./google-services.json
